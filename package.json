{
  "name": "easy-tools-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://dsun6652-oss.github.io/easy-tools-hub",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:extension": "tsc --noEmit && vite build --config vite.extension.config.ts --mode chrome && node scripts/copy-extension-files.mjs",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "gh-pages": "^6.3.0",
    "typescript": "~5.6.3",
    "vite": "^5.0.0"
  }
}
